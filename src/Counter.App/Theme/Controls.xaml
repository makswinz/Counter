<!--
    Every interactive control in Counter. Nothing here falls back to a stock WPF template.

    Icon buttons carry a typed IconKind rather than a geometry in Tag, so a view cannot put the
    wrong kind of thing in one and get a silently empty button. All templates implement normal,
    hover, pressed, keyboard-focused, selected and disabled states, and none of them changes an
    icon's size between states.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:ctl="clr-namespace:Counter.App.Controls"
                    xmlns:conv="clr-namespace:Counter.App.Converters"
                    mc:Ignorable="po">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
        <ResourceDictionary Source="Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:InsetCornerRadiusConverter x:Key="InsetRadius" />

    <!-- ==================================================================== Elevation -->
    <!--
        One shadow per floating surface, and only two weights of it. Nothing inside a panel gets a
        shadow of its own: a task row, an icon, a badge or a heatmap square with its own drop
        shadow is what turns a layered interface into a muddy one, and it costs a render-target
        pass each.

        The direction is the same for both, and it agrees with the light: the source is at the
        upper left, so the shadow falls downward and slightly to the right. The colour comes from
        the theme, because a black shadow on a light interface reads as dirt rather than as depth.
    -->

    <DropShadowEffect x:Key="PanelShadow"
                      Color="{DynamicResource ShadowColor}"
                      BlurRadius="24" ShadowDepth="7" Direction="295"
                      Opacity="0.55" RenderingBias="Performance" />

    <DropShadowEffect x:Key="PopupShadow"
                      Color="{DynamicResource ShadowColor}"
                      BlurRadius="30" ShadowDepth="10" Direction="295"
                      Opacity="0.66" RenderingBias="Performance" />

    <!--
        Frosted glass sits closer to the desktop and casts a longer, weaker shadow: the
        reference's -4px 12px 20px at 22 percent. The horizontal offset is mirrored, because
        that reference is lit from the upper right and everything in this application is lit
        from the upper left, and one light source is worth more than one borrowed number.
    -->
    <DropShadowEffect x:Key="FrostedPanelShadow"
                      Color="{DynamicResource ShadowColor}"
                      BlurRadius="20" ShadowDepth="12.6" Direction="288"
                      Opacity="0.34" RenderingBias="Performance" />

    <!-- Liquid glass barely casts at all. Its depth comes from the halo around it instead. -->
    <DropShadowEffect x:Key="LiquidPanelShadow"
                      Color="{DynamicResource ShadowColor}"
                      BlurRadius="18" ShadowDepth="6" Direction="288"
                      Opacity="0.26" RenderingBias="Performance" />

    <!-- The two radii that turn the rim colour into an inset glow. Tight for frosted, which is
         the reference's 4px blur with 2px of spread; wide and thin for liquid, which is its
         12px blur pulled back by 4. -->
    <BlurEffect x:Key="RimBlurTight" Radius="5" KernelType="Gaussian" />

    <!-- Wide and soft: the band is meant to be felt across several pixels rather than seen as a
         line, which is the difference between an edge that reads as thick and one that reads as
         drawn on. -->
    <BlurEffect x:Key="RefractionBlur" Radius="9" KernelType="Gaussian" />
    <BlurEffect x:Key="RimBlurSoft" Radius="14" KernelType="Gaussian" />
    <BlurEffect x:Key="HaloBlur" Radius="12" KernelType="Gaussian" />

    <!-- ==================================================================== Focus visuals -->
    <!--
        A focus visual, not a trigger on IsKeyboardFocused. That distinction is the whole reason
        these exist: Windows draws a focus visual only when focus actually arrived from the
        keyboard, so a control shows its ring after Tab and stays clean after an ordinary mouse
        click, without any template having to guess which one happened.

        The ring is drawn in the adorner layer, outside the control's own bounds, so it can never
        be mistaken for a border of the control itself and can never double one up.
    -->

    <Style x:Key="NoFocusVisual">
        <Setter Property="Control.Template" Value="{x:Null}" />
    </Style>

    <Style x:Key="FocusRingVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2"
                            CornerRadius="{StaticResource FocusRingRadius}"
                            BorderThickness="{DynamicResource HairlineThickness}"
                            BorderBrush="{DynamicResource FocusRingBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A 20 px circle around a 16 px control: 2 px of clear air on every side. -->
    <Style x:Key="FocusRingCircleVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Width="{StaticResource FocusCircleSize}"
                             Height="{StaticResource FocusCircleSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stroke="{DynamicResource FocusRingBrush}"
                             StrokeThickness="{DynamicResource HairlinePixel}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same ring around the large primary button, which is 34 px rather than 16. -->
    <Style x:Key="FocusRingLargeCircleVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Width="{StaticResource FocusCircleLargeSize}"
                             Height="{StaticResource FocusCircleLargeSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stroke="{DynamicResource FocusRingBrush}"
                             StrokeThickness="{DynamicResource HairlinePixel}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Half a pixel down on press. A transform, not a margin, so pressing cannot relayout. -->
    <TranslateTransform x:Key="IconPressNudge" X="0" Y="0.5" po:Freeze="True" />

    <!-- ==================================================================== Liquid glass -->
    <!--
        The material every top-level surface in the application is made of, written down once.

        The layers, outermost first:

          halo        light thrown outward instead of shadow           liquid only
          glow        the accent, at a tenth or less, past the edge
          contour     a real one-physical-pixel ring, lit from the upper left
          body        the glass itself, clipped so nothing inside can reach a corner
            tint          the wash that gives the surface its own colour
            reflection    the warm light of something active nearby, when there is something
            edge light    the far corner catching light, gone by the middle     frosted only
            top sheen     the fall of light down the face                       frosted only
            specular      the highlight where the light actually lands
            ripple        the slow unevenness of a pour                         liquid only
            inner edge    a fainter second line, which is what reads as thickness
            refraction    the band where a thick edge bends what passes through it
            rim           a blurred stroke inside the clip: light held in the edge
            content

        Three materials share the stack and differ only in which layers are lit, because the
        alternative - three templates - is three places for the layer order to drift apart.

          Solid    dense smoked glass, a drawn edge, one specular highlight
          Frosted  a pale wash, a soft rim instead of a hard second line, edge light and sheen
          Liquid   almost no tint, one wide soft rim, a ripple, and a halo outside

        The contour survives all three. The reference designs for the two translucent materials
        carry no border at all and let an inset glow do the work, and on a web page that is
        right: the card sits inside a document that already frames it. This panel sits on top of
        whatever the desktop happens to be, and an edge that disappears over a pale wallpaper is
        a window you cannot find. So the structural ring stays, and the rim is added inside it.

        The contour is built as nested borders rather than as a BorderBrush: the outer border is
        filled with the contour brush and padded by exactly one physical pixel, and the body sits
        inside that padding. It is the construction that guarantees the ring is the same weight
        all the way round a rounded corner, which a stroked border does not.
    -->

    <Style TargetType="{x:Type ctl:LiquidGlassPanel}">
        <Setter Property="ContourBrush" Value="{DynamicResource GlassContourBrush}" />
        <Setter Property="AccentContourBrush" Value="{DynamicResource AccentContourBrush}" />
        <Setter Property="GlowBrush" Value="{DynamicResource AccentGlowBrush}" />
        <Setter Property="GlassBrush" Value="{DynamicResource GlassBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <!-- One entry decides the material for every surface in the interface at once. -->
        <Setter Property="Material" Value="{DynamicResource GlassMaterial}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:LiquidGlassPanel}">
                    <Grid>
                        <!-- Liquid glass throws light outward rather than shadow. A ring rather
                             than a filled rectangle, so the halo stays outside the panel instead
                             of brightening the middle of a surface that is already translucent. -->
                        <Border x:Name="Halo"
                                Margin="2"
                                BorderBrush="{DynamicResource GlassHaloBrush}"
                                BorderThickness="6"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Effect="{StaticResource HaloBlur}" />

                        <!-- The accent glow. Drawn into a negative margin so it spills past the
                             edge without making the panel any larger, and never hit-testable. -->
                        <Border x:Name="Glow"
                                Margin="-3,-1,-3,-5"
                                Background="{TemplateBinding GlowBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="{TemplateBinding GlowOpacity}"
                                IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="14" KernelType="Gaussian" />
                            </Border.Effect>
                        </Border>

                        <!-- The structural contour, and the single shadow. -->
                        <Border x:Name="Contour"
                                Background="{TemplateBinding ContourBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{DynamicResource HairlineThickness}"
                                Effect="{StaticResource PanelShadow}"
                                SnapsToDevicePixels="True">
                            <Border x:Name="Body"
                                    Background="{TemplateBinding GlassBrush}"
                                    Opacity="{TemplateBinding GlassOpacity}"
                                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InsetRadius}, ConverterParameter=1}"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="Tint"
                                               Fill="{DynamicResource GlassTintBrush}"
                                               IsHitTestVisible="False" />

                                    <Rectangle x:Name="Reflection"
                                               Fill="{DynamicResource AccentAmbientBrush}"
                                               Opacity="0"
                                               IsHitTestVisible="False" />

                                    <!-- The far edge catching light, and the fall down the face.
                                         Both belong to frosted glass; solid glass carries the
                                         specular sheen alone and liquid glass carries neither. -->
                                    <Rectangle x:Name="EdgeReflection"
                                               Fill="{DynamicResource GlassEdgeReflectionBrush}"
                                               Opacity="0"
                                               IsHitTestVisible="False" />

                                    <Rectangle x:Name="TopSheen"
                                               Fill="{DynamicResource GlassTopSheenBrush}"
                                               Opacity="0"
                                               IsHitTestVisible="False" />

                                    <Rectangle x:Name="Sheen"
                                               Fill="{DynamicResource SpecularHighlightBrush}"
                                               IsHitTestVisible="False" />

                                    <!-- The slow unevenness of a pour. Liquid glass only, and
                                         never animated: a surface that moves while nothing is
                                         happening is the most distracting thing a window can do. -->
                                    <Rectangle x:Name="Ripple"
                                               Fill="{DynamicResource GlassRippleBrush}"
                                               Opacity="0"
                                               IsHitTestVisible="False" />

                                    <Border x:Name="InnerEdge"
                                            BorderBrush="{DynamicResource GlassInnerContourBrush}"
                                            BorderThickness="{DynamicResource HairlineThickness}"
                                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InsetRadius}, ConverterParameter=1}"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="True" />

                                    <!--
                                        The refraction band.

                                        A thick edge of glass does not simply end: it bends what
                                        passes through it, so the last few millimetres before the
                                        boundary are brighter on the side the light comes from and
                                        deeper on the side it leaves. That is the cue the eye
                                        reads as thickness, and it is why a flat tinted rectangle
                                        never looks like glass however transparent it is.

                                        A wide blurred stroke inside the clip, running along the
                                        same upper-left light as everything else. It is drawn
                                        under the rim so the two stack the way a real edge does:
                                        the band is the body of the glass, the rim is the
                                        highlight on its very lip.
                                    -->
                                    <Border x:Name="Refraction"
                                            BorderBrush="{DynamicResource GlassRefractionBrush}"
                                            BorderThickness="7"
                                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InsetRadius}, ConverterParameter=1}"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource RefractionBlur}" />

                                    <!-- The inset glow. A blurred stroke drawn inside a clipped
                                         body, which is what an inset box-shadow actually is: the
                                         outer half of the blur is cut away by the clip and the
                                         inner half becomes light held in the edge. -->
                                    <Border x:Name="Rim"
                                            Margin="0"
                                            BorderBrush="{DynamicResource GlassRimBrush}"
                                            BorderThickness="2"
                                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InsetRadius}, ConverterParameter=1}"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource RimBlurTight}" />

                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                        </Border>

                        <!-- The accent ring, laid exactly over the structural one and crossfaded
                             by state. Overlaid rather than swapped in, so the panel never loses
                             its outline halfway through a transition. -->
                        <Border x:Name="Accent"
                                BorderBrush="{TemplateBinding AccentContourBrush}"
                                BorderThickness="{DynamicResource HairlineThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="{TemplateBinding ContourOpacity}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--
                            Frosted glass: the pale wash is already in GlassTintBrush, so what is
                            added here is the light. The far edge catches it, the top sheds it
                            down the face, and the rim holds a little of it just inside the
                            boundary in place of a hard second line.
                        -->
                        <Trigger Property="Material" Value="Frosted">
                            <Setter TargetName="Refraction" Property="Opacity" Value="1" />
                            <Setter TargetName="EdgeReflection" Property="Opacity" Value="1" />
                            <Setter TargetName="TopSheen" Property="Opacity" Value="1" />
                            <Setter TargetName="Rim" Property="Opacity" Value="1" />
                            <!-- The specular is pulled back rather than removed. Frosted glass
                                 still has one light source and still has to agree with every
                                 other surface about where it is. -->
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.5" />
                            <Setter TargetName="InnerEdge" Property="Opacity" Value="0.5" />
                        </Trigger>

                        <!--
                            Liquid glass: almost no tint, no drawn inner line at all, one wide
                            soft light inside the edge, the ripple, and a halo outside.
                        -->
                        <Trigger Property="Material" Value="Liquid">
                            <Setter TargetName="Refraction" Property="Opacity" Value="1" />
                            <Setter TargetName="Refraction" Property="BorderThickness" Value="10" />
                            <Setter TargetName="Rim" Property="Opacity" Value="1" />
                            <Setter TargetName="Rim" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Rim" Property="Margin" Value="3" />
                            <Setter TargetName="Rim" Property="Effect" Value="{StaticResource RimBlurSoft}" />
                            <Setter TargetName="Ripple" Property="Opacity" Value="1" />
                            <Setter TargetName="InnerEdge" Property="Opacity" Value="0" />
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.35" />
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- A blurred layer costs a render-target pass whether or not anybody can
                             see it, and most panels never glow at all, so the layer is removed
                             from the tree rather than merely made transparent. -->
                        <Trigger Property="GlowOpacity" Value="0">
                            <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowAccent" Value="True">
                            <Setter TargetName="Reflection" Property="Opacity"
                                    Value="{Binding AccentReflectionOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <!-- Last, so a surface that asks for no sheen gets none whatever it is
                             made of. -->
                        <Trigger Property="ShowTopHighlight" Value="False">
                            <Setter TargetName="Sheen" Property="Opacity" Value="0" />
                            <Setter TargetName="TopSheen" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="Elevation" Value="Popup">
                            <Setter TargetName="Contour" Property="Effect" Value="{StaticResource PopupShadow}" />
                        </Trigger>
                        <Trigger Property="Elevation" Value="Flush">
                            <Setter TargetName="Contour" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Halo" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Each material casts its own panel shadow. These come after the
                             elevation triggers so that a panel gets its material's shadow, and a
                             popup or a flush surface still gets the one its elevation asks for. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Material" Value="Frosted" />
                                <Condition Property="Elevation" Value="Panel" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Contour" Property="Effect" Value="{StaticResource FrostedPanelShadow}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Material" Value="Liquid" />
                                <Condition Property="Elevation" Value="Panel" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Contour" Property="Effect" Value="{StaticResource LiquidPanelShadow}" />
                        </MultiTrigger>

                        <!-- Last, so it wins over every elevation and every material: a panel
                             with a compositor backdrop under it is already being shadowed by
                             the compositor, and drawing a second one only deepens the halo. -->
                        <Trigger Property="HasBackdrop" Value="True">
                            <Setter TargetName="Contour" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== Icon buttons -->
    <!--
        One template, five states, every icon button in the application.

        Normal   transparent, secondary ink
        Hover    raised surface, primary ink
        Pressed  pressed surface, ink moved half a pixel down
        Selected accent-tinted surface, accent ink - the current destination
        Disabled 38 percent, no hover, no hand cursor

        The icon sits in a fixed square host centred in the hit target, so nothing about a state
        changes its size or its position other than that half pixel.
    -->

    <Style x:Key="IconButton" TargetType="{x:Type ctl:IconButton}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="IconSize" Value="{StaticResource IconSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:IconButton}">
                    <Grid Background="{DynamicResource TransparentBrush}">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlRadius}"
                                SnapsToDevicePixels="True" />
                        <ctl:AppIcon x:Name="Icon"
                                     Kind="{TemplateBinding Icon}"
                                     Variant="{TemplateBinding IconVariant}"
                                     IconSize="{TemplateBinding IconSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Icon" Property="Variant" Value="Filled" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                            <Setter TargetName="Icon" Property="RenderTransform" Value="{StaticResource IconPressNudge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.38" />
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TransparentBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The default for a bare IconButton, so one dropped into a view is never unstyled. -->
    <Style TargetType="{x:Type ctl:IconButton}" BasedOn="{StaticResource IconButton}" />

    <Style x:Key="IconButtonCompact" TargetType="{x:Type ctl:IconButton}" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="{StaticResource IconButtonCompactSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonCompactSize}" />
    </Style>

    <!-- ==================================================================== Primary icon button -->
    <!--
        The one control in the interface that is made of light: starting and holding a session.

        Five layers, and they are the whole design:

          glow        the accent spilling past the disc, eight percent at rest
          rim         the deepest stop of the ramp, a single physical pixel, so the disc has an
                      edge instead of dissolving into whatever is behind it
          disc        the five-stop accent gradient, lit from the upper left
          gloss       white, straight down the face, gone before the middle - light, not paint
          icon        the filled glyph, in whichever of white or near-black the engine measured
                      as readable on this particular accent

        No outline, no second circle, no ring around the ring, and nothing here changes size
        between states. Hovering lifts the gloss and the glow; pressing lowers the gloss, lays a
        thin shade over the disc so the whole ramp darkens together, and moves the glyph half a
        pixel down. Nothing scales.
    -->

    <Style x:Key="PrimaryIconButton" TargetType="{x:Type ctl:IconButton}">
        <Setter Property="Width" Value="{StaticResource PrimaryButtonSize}" />
        <Setter Property="Height" Value="{StaticResource PrimaryButtonSize}" />
        <Setter Property="Icon" Value="Play" />
        <Setter Property="IconVariant" Value="Filled" />
        <Setter Property="IconSize" Value="{StaticResource IconSizePlay}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGlyphBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingCircleVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:IconButton}">
                    <Grid Background="{DynamicResource TransparentBrush}">
                        <!-- The halo spills past the disc, so it is drawn into the margin rather
                             than inside it and cannot shrink the button. -->
                        <Ellipse x:Name="Halo" Margin="-6" Opacity="0.72" Fill="{DynamicResource AccentHaloBrush}" />

                        <!-- Rim first, then the disc drawn a pixel inside it: the same nested
                             construction the glass panels use, for the same reason. -->
                        <Ellipse x:Name="Rim" Fill="{DynamicResource AccentDeepBrush}" />

                        <Ellipse x:Name="Disc"
                                 Margin="{DynamicResource HairlineThickness}"
                                 Fill="{DynamicResource AccentGradientBrush}" />

                        <Ellipse x:Name="Gloss"
                                 Margin="{DynamicResource HairlineThickness}"
                                 Fill="{StaticResource GlossOverlayBrush}" />

                        <!-- Pressed shade. Transparent at rest, so it costs nothing until it is
                             needed, and it darkens every stop of the ramp by the same amount
                             rather than replacing the gradient with a second one. -->
                        <Ellipse x:Name="Shade"
                                 Margin="{DynamicResource HairlineThickness}"
                                 Fill="{DynamicResource GlassInnerShadowBrush}"
                                 Opacity="0" />

                        <ctl:AppIcon x:Name="Icon"
                                     Kind="{TemplateBinding Icon}"
                                     Variant="{TemplateBinding IconVariant}"
                                     IconSize="{TemplateBinding IconSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            <Setter TargetName="Gloss" Property="Opacity" Value="1.15" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Icon" Property="RenderTransform" Value="{StaticResource IconPressNudge}" />
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Shade" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Disc" Property="Opacity" Value="0.38" />
                            <Setter TargetName="Rim" Property="Opacity" Value="0.38" />
                            <Setter TargetName="Gloss" Property="Opacity" Value="0" />
                            <Setter TargetName="Halo" Property="Opacity" Value="0" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same control at the size the notch wants. One style, one size setter: the notch play
         button and the row play button must not be able to drift into two different designs. -->
    <Style x:Key="PrimaryIconButtonLarge" TargetType="{x:Type ctl:IconButton}" BasedOn="{StaticResource PrimaryIconButton}">
        <Setter Property="Width" Value="{StaticResource PrimaryButtonLargeSize}" />
        <Setter Property="Height" Value="{StaticResource PrimaryButtonLargeSize}" />
        <Setter Property="IconSize" Value="{StaticResource IconSizePlayLarge}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingLargeCircleVisual}" />
    </Style>

    <!-- ==================================================================== Destructive -->
    <!--
        Neutral until hovered. Delete is never red at rest: a row full of red buttons reads as a
        row full of errors, and the colour stops meaning anything at the moment it is needed.
    -->

    <Style x:Key="DestructiveIconButton" TargetType="{x:Type ctl:IconButton}" BasedOn="{StaticResource IconButtonCompact}">
