    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PillHeight}" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="{StaticResource PillPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontPill}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
