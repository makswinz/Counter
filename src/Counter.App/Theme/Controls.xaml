        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:IconButton}">
                    <Grid Background="{DynamicResource TransparentBrush}">
                        <Border x:Name="Bg"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="{StaticResource ControlRadius}"
                                SnapsToDevicePixels="True" />
                        <ctl:AppIcon x:Name="Icon"
                                     Kind="{TemplateBinding Icon}"
                                     Variant="{TemplateBinding IconVariant}"
                                     IconSize="{TemplateBinding IconSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DestructiveHoverBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DestructivePressedBrush}" />
                            <Setter TargetName="Icon" Property="RenderTransform" Value="{StaticResource IconPressNudge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== Transport -->
    <!--
        The notch's own play and pause: the primary control of the whole application, and the one
        the reference treats as the focal point. It is the large primary button, so it is lit,
        rimmed and glossed exactly like the one in a task row - the same style, one size larger.
    -->

    <Style x:Key="TransportButton" TargetType="{x:Type ctl:IconButton}" BasedOn="{StaticResource PrimaryIconButtonLarge}" />

    <!-- ==================================================================== Icon toggles -->

    <Style x:Key="ToggleIconButton" TargetType="{x:Type ctl:IconToggleButton}">
        <Setter Property="Width" Value="{StaticResource IconButtonCompactSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonCompactSize}" />
        <Setter Property="IconSize" Value="{StaticResource IconSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:IconToggleButton}">
                    <Grid Background="{DynamicResource TransparentBrush}">
                        <Border x:Name="Bg"
                                Background="{DynamicResource TransparentBrush}"
                                CornerRadius="{StaticResource ControlRadius}"
                                SnapsToDevicePixels="True" />
                        <ctl:AppIcon x:Name="Icon"
                                     Kind="{TemplateBinding Icon}"
                                     IconSize="{TemplateBinding IconSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <!-- Weight as well as colour, so the state survives a colour-blind
                                 reading and a screenshot in grayscale. -->
                            <Setter TargetName="Icon" Property="Variant" Value="Filled" />
                            <Setter TargetName="Icon" Property="Kind"
                                    Value="{Binding CheckedIcon, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Icon" Property="RenderTransform" Value="{StaticResource IconPressNudge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ctl:IconToggleButton}" BasedOn="{StaticResource ToggleIconButton}" />

    <!-- ==================================================================== Circular badge -->
    <!--
        The content is centred in the same box the control draws its disc into, so the content
        cannot move the circle and the circle cannot move the content. Nothing here is padded on
        one side, which is the only way a badge stays centred for "1" and for "31" alike.
    -->

    <Style TargetType="{x:Type ctl:CircularBadge}">
        <Setter Property="Fill" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontMeta}" />
        <Setter Property="TextBlock.TextAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:CircularBadge}">
                    <Grid Width="{TemplateBinding Diameter}"
                          Height="{TemplateBinding Diameter}"
                          Background="{DynamicResource TransparentBrush}"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <!-- The disc is drawn by the control, not placed here: see
                             CircularBadge.OnRender. The template positions the content. -->
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.TextAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                          TextOptions.TextFormattingMode="Ideal">
                            <ContentPresenter.RenderTransform>
                                <!-- The one permitted optical correction, and it moves the
                                     content rather than the circle. -->
                                <TranslateTransform Y="{Binding BaselineOffset, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== Completion check -->
    <!--
        One 16 x 16 visual inside a transparent 28 x 28 hit target.

        Unchecked it is a hairline circle and nothing else - no glow, no second outline, no blue
        anywhere. Checked, the fill and the contour are the same colour, which is what makes it
        impossible for a contour to be a different weight or a different hue from the thing it
        surrounds. The tick is Fluent's own 12-grid checkmark rendered at 10 px inside the same
        fixed host every other icon uses, so it is centred by the same rule.

        That colour is the completion family, not the accent. Finishing a task is a meaning rather
        than a preference: if the tick followed the accent, choosing green would make every open
        task look done, and choosing red would make finishing one look like a failure. It is the
        same green whatever colour the rest of the interface is wearing - and the tick and the
        struck-through title say so as well, for anyone who cannot see the difference.

        Nothing scales, bounces or spins, and every element is a fixed size, so ticking a task
        off cannot move a single pixel of the row it is in.
    -->

    <Style x:Key="CompletionCircle" TargetType="{x:Type ctl:CompletionCheck}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingCircleVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:CompletionCheck}">
                    <!-- The hit target. Transparent, larger than the visual, and it does not
                         move the visual off centre because both are centred in the same cell. -->
                    <Grid Background="{DynamicResource TransparentBrush}">
                        <Grid x:Name="Visual"
                              Width="{StaticResource CompletionCircleSize}"
                              Height="{StaticResource CompletionCircleSize}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">

                            <!-- Everything that fills the circle is clipped to it, so nothing
                                 can ever paint a corner outside the shape. -->
                            <Grid>
                                <Grid.Clip>
                                    <EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8" />
                                </Grid.Clip>

                                <Ellipse x:Name="Wash"
                                         Fill="{DynamicResource SuccessSoftBrush}"
                                         Opacity="0" />

                                <Ellipse x:Name="Fill"
                                         Fill="{DynamicResource SuccessGradientBrush}"
                                         Opacity="0" />

                                <Ellipse x:Name="Gloss"
                                         Fill="{StaticResource GlossOverlayBrush}"
                                         Opacity="0" />

                                <ctl:AppIcon x:Name="Tick"
                                             Kind="Checkmark"
                                             IconSize="{StaticResource CompletionTickSize}"
                                             Foreground="{DynamicResource SuccessGlyphBrush}"
                                             Opacity="0" />
                            </Grid>

                            <!-- The single contour. Neutral when open, the same colour as the
                                 fill when done, and there is never a second one. -->
                            <Ellipse x:Name="Ring"
                                     Stroke="{DynamicResource TextMutedBrush}"
                                     StrokeThickness="{StaticResource CompletionRingThickness}" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="Wash" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Gloss"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         BeginTime="0:0:0.02" />
                                        <DoubleAnimation Storyboard.TargetName="Wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Gloss"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Visual" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ctl:CompletionCheck}" BasedOn="{StaticResource CompletionCircle}" />

    <!-- ==================================================================== Text buttons -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource ActionButtonHeight}" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{DynamicResource PrimaryFillBrush}"
                                CornerRadius="{StaticResource InputRadius}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Ring"
                                CornerRadius="{StaticResource InputRadius}"
                                Margin="-2"
                                BorderThickness="{DynamicResource HairlineThickness}"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                Opacity="0" />
                        <ContentPresenter x:Name="Label"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Label" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.5" />
