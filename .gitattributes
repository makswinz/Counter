# Normalise line endings in the repository and check out what the platform expects. Without
# this, a contributor on macOS or Linux produces a diff touching every line of every file.
* text=auto

*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.ps1       text eol=crlf
*.psd1      text eol=crlf
*.iss       text eol=crlf
*.md        text
*.yml       text
*.svg       text

*.ico       binary
*.png       binary
*.db        binary
